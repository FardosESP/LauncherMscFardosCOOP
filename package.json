{
  "name": "fardos-msc-coop",
  "productName": "Fardos MSC Coop",
  "version": "1.0.15",
  "description": "Launcher multijugador cooperativo para My Summer Car",
  "author": "Fardos",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.fardos.msccoop",
    "productName": "Fardos MSC Coop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/app.ico",
      "artifactName": "Fardos-MSC-Coop-${version}.exe"
    },
    "extraResources": [
      {
        "from": "tools",
        "to": "tools"
      }
    ],
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "FardosESP",
      "repo": "LauncherMscFardosCOOP",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
